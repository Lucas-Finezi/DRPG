{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:drpg:schema:expression",
  "title": "Expression",
  "description": "Closed, side-effect-free grammar for numbers and dice. The engine evaluates it deterministically; dice are rolled by the engine's RNG. Variables must be declared in the system's 'variables' registry. There is no free-text formula: what cannot be expressed here becomes a master decision.",
  "oneOf": [
    {
      "description": "Integer or fractional constant (fractions appear e.g. in CR 1/8 or weight 1/4 lb.).",
      "type": "number"
    },
    {
      "description": "Dice pool written as NdF, e.g. '8d6', '1d20', '1d100'.",
      "type": "string",
      "pattern": "^[1-9][0-9]*d(?:2|3|4|6|8|10|12|20|100)$"
    },
    { "$ref": "#/$defs/var" },
    { "$ref": "#/$defs/dice" },
    { "$ref": "#/$defs/arith" },
    { "$ref": "#/$defs/lookup" },
    { "$ref": "#/$defs/scale" }
  ],
  "$defs": {
    "var": {
      "description": "Read a registered variable, e.g. {'var': 'ability_mod.str'}, {'var': 'spell_slot_level'}.",
      "type": "object",
      "required": ["var"],
      "additionalProperties": false,
      "properties": {
        "var": { "$ref": "urn:drpg:schema:common#/$defs/registry_name" }
      }
    },
    "dice": {
      "description": "Dice pool whose count is computed, e.g. 8d6 plus 1d6 per slot level above 3.",
      "type": "object",
      "required": ["dice"],
      "additionalProperties": false,
      "properties": {
        "dice": {
          "type": "object",
          "required": ["count", "faces"],
          "additionalProperties": false,
          "properties": {
            "count": { "$ref": "#" },
            "faces": { "enum": [2, 3, 4, 6, 8, 10, 12, 20, 100] }
          }
        }
      }
    },
    "arith": {
      "description": "Arithmetic over sub-expressions. 'div' rounds down unless 'round' says otherwise (the SRD rounds down by default).",
      "type": "object",
      "required": ["op", "args"],
      "additionalProperties": false,
      "properties": {
        "op": { "enum": ["add", "sub", "mul", "div", "min", "max", "neg", "abs"] },
        "args": { "type": "array", "items": { "$ref": "#" }, "minItems": 1 },
        "round": { "enum": ["down", "up", "none"], "default": "down" }
      }
    },
    "lookup": {
      "description": "Read a cell of a table published by an entry, e.g. the Rages column of the Barbarian Features table at the current Barbarian level.",
      "type": "object",
      "required": ["table", "key", "column"],
      "additionalProperties": false,
      "properties": {
        "table": { "$ref": "urn:drpg:schema:common#/$defs/ref" },
        "table_id": { "description": "Id of the table inside the entry's data.tables.", "type": "string" },
        "key": { "$ref": "#" },
        "column": { "type": "string" }
      }
    },
    "scale": {
      "description": "Step function over a variable: the value of the highest step whose 'from' is <= the variable (e.g. cantrip damage at character levels 1/5/11/17).",
      "type": "object",
      "required": ["scale"],
      "additionalProperties": false,
      "properties": {
        "scale": {
          "type": "object",
          "required": ["by", "steps"],
          "additionalProperties": false,
          "properties": {
            "by": { "$ref": "urn:drpg:schema:common#/$defs/registry_name" },
            "steps": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["from", "value"],
                "additionalProperties": false,
                "properties": {
                  "from": { "type": "number" },
                  "value": { "$ref": "#" }
                }
              }
            }
          }
        }
      }
    }
  }
}
