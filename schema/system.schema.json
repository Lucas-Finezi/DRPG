{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:drpg:schema:system",
  "title": "System",
  "description": "Definition of a game system: core dice, abilities, proficiency, action economy, rests, progression, currencies, units, and the registries that close the effect vocabulary. Every identifier used by entries of this system (stats, rolls, events, predicates, variables, damage types...) must be declared here.",
  "type": "object",
  "required": [
    "id",
    "name",
    "schema_version",
    "source",
    "core_die",
    "abilities",
    "proficiency_bonus",
    "levels",
    "action_economy",
    "rests",
    "currency",
    "units",
    "registries"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "$ref": "urn:drpg:schema:common#/$defs/slug"
    },
    "ref": {
      "description": "Ref of the system definition itself ('<system>/system/<id>'), so entries can point into it (e.g. 'dnd5e/system/dnd5e#/abilities').",
      "$ref": "urn:drpg:schema:common#/$defs/ref"
    },
    "name": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.0"
    },
    "source": {
      "$ref": "urn:drpg:schema:source"
    },
    "core_die": {
      "type": "object",
      "required": [
        "die",
        "rules"
      ],
      "additionalProperties": false,
      "properties": {
        "die": {
          "const": "d20"
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rule"
          },
          "minItems": 1
        }
      }
    },
    "abilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "abbreviation",
          "measures"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "urn:drpg:schema:common#/$defs/identifier"
          },
          "name": {
            "type": "string"
          },
          "abbreviation": {
            "type": "string"
          },
          "measures": {
            "type": "string"
          },
          "pages": {
            "$ref": "#/$defs/pages"
          }
        }
      }
    },
    "ability_scores": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": {
          "type": "integer"
        },
        "max": {
          "type": "integer"
        },
        "modifier_table": {
          "description": "Score ranges and their modifiers, as printed in the source (the source gives a table, not a formula).",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "min",
              "max",
              "modifier"
            ],
            "additionalProperties": false,
            "properties": {
              "min": {
                "type": "integer"
              },
              "max": {
                "type": "integer"
              },
              "modifier": {
                "type": "integer"
              }
            }
          }
        },
        "descriptors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rule"
          }
        },
        "pages": {
          "$ref": "#/$defs/pages"
        }
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "ability"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "urn:drpg:schema:common#/$defs/identifier"
          },
          "name": {
            "type": "string"
          },
          "ability": {
            "$ref": "urn:drpg:schema:common#/$defs/identifier"
          },
          "example_uses": {
            "type": "string"
          },
          "pages": {
            "$ref": "#/$defs/pages"
          }
        }
      }
    },
    "proficiency_bonus": {
      "type": "object",
      "required": [
        "by_level"
      ],
      "additionalProperties": false,
      "properties": {
        "by_level": {
          "description": "Character level (string key) -> Proficiency Bonus.",
          "type": "object",
          "patternProperties": {
            "^[0-9]+$": {
              "type": "integer"
            }
          },
          "additionalProperties": false
        },
        "by_challenge_rating": {
          "description": "Ranges of Challenge Rating and their Proficiency Bonus.",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "min",
              "max",
              "bonus"
            ],
            "additionalProperties": false,
            "properties": {
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              },
              "bonus": {
                "type": "integer"
              }
            }
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rule"
          }
        },
        "pages": {
          "$ref": "#/$defs/pages"
        }
      }
    },
    "levels": {
      "type": "object",
      "required": [
        "min",
        "max",
        "advancement"
      ],
      "additionalProperties": false,
      "properties": {
        "min": {
          "type": "integer"
        },
        "max": {
          "type": "integer"
        },
        "advancement": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "level",
              "xp"
            ],
            "additionalProperties": false,
            "properties": {
              "level": {
                "type": "integer"
              },
              "xp": {
                "type": "integer"
              },
              "proficiency_bonus": {
                "type": "integer"
              }
            }
          }
        },
        "tiers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rule"
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rule"
          }
        },
        "pages": {
          "$ref": "#/$defs/pages"
        }
      }
    },
    "action_economy": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "per"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "urn:drpg:schema:common#/$defs/identifier"
          },
          "name": {
            "type": "string"
          },
          "per": {
            "enum": [
              "turn",
              "round"
            ]
          },
          "count": {
            "type": "integer"
          },
          "refreshes_on": {
            "$ref": "urn:drpg:schema:common#/$defs/registry_name"
          },
          "rules": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/rule"
            }
          },
          "pages": {
            "$ref": "#/$defs/pages"
          }
        }
      }
    },
    "initiative": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "check": {
          "description": "Initiative is an ability check with this ability.",
          "$ref": "urn:drpg:schema:common#/$defs/identifier"
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rule"
          }
        },
        "pages": {
          "$ref": "#/$defs/pages"
        }
      }
    },
    "rests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "ref"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "urn:drpg:schema:common#/$defs/identifier"
          },
          "name": {
            "type": "string"
          },
          "ref": {
            "description": "Rule entry with the full procedure (owned by L07).",
            "$ref": "urn:drpg:schema:common#/$defs/ref"
          },
          "minimum_duration": {
            "$ref": "urn:drpg:schema:duration"
          },
          "pages": {
            "$ref": "#/$defs/pages"
          }
        }
      }
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "category"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "urn:drpg:schema:common#/$defs/identifier"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "enum": [
              "standard",
              "rare"
            ]
          },
          "roll": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "pages": {
            "$ref": "#/$defs/pages"
          }
        }
      }
    },
    "currency": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "abbreviation",
          "value_in_cp"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "urn:drpg:schema:common#/$defs/identifier"
          },
          "name": {
            "type": "string"
          },
          "abbreviation": {
            "type": "string"
          },
          "value_in_cp": {
            "type": "number"
          },
          "pages": {
            "$ref": "#/$defs/pages"
          }
        }
      }
    },
    "units": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "unit"
        ],
        "additionalProperties": false,
        "properties": {
          "unit": {
            "type": "string"
          },
          "conversions": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          },
          "pages": {
            "$ref": "#/$defs/pages"
          }
        }
      }
    },
    "registries": {
      "description": "Closed vocabularies. Effects, expressions, targets and durations may only use names declared here.",
      "type": "object",
      "required": [
        "variables",
        "stats",
        "rolls",
        "events",
        "predicates",
        "damage_types",
        "sizes",
        "creature_types",
        "area_shapes",
        "senses",
        "movement_modes",
        "frequencies"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/registry"
      },
      "properties": {
        "variables": {
          "$ref": "#/$defs/registry"
        },
        "stats": {
          "$ref": "#/$defs/registry"
        },
        "rolls": {
          "$ref": "#/$defs/registry"
        },
        "events": {
          "$ref": "#/$defs/registry"
        },
        "predicates": {
          "$ref": "#/$defs/registry"
        },
        "damage_types": {
          "$ref": "#/$defs/registry"
        },
        "sizes": {
          "$ref": "#/$defs/registry"
        },
        "creature_types": {
          "$ref": "#/$defs/registry"
        },
        "area_shapes": {
          "$ref": "#/$defs/registry"
        },
        "senses": {
          "$ref": "#/$defs/registry"
        },
        "movement_modes": {
          "$ref": "#/$defs/registry"
        },
        "frequencies": {
          "$ref": "#/$defs/registry"
        }
      }
    },
    "core_rules": {
      "description": "General principles that apply across the system (e.g. exceptions supersede general rules, round down).",
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "round_seconds": {
          "type": "number"
        },
        "derived": {
          "description": "Conversions the engine needs that the source implies but does not print; each names the statement it derives from.",
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rule"
          }
        }
      }
    },
    "abbreviations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "pages": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "minItems": 1
    },
    "rule": {
      "description": "A rule statement kept verbatim, with its pages; 'id' lets entries cite it.",
      "type": "object",
      "required": [
        "text",
        "pages"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]+$"
        },
        "text": {
          "$ref": "urn:drpg:schema:common#/$defs/text"
        },
        "pages": {
          "$ref": "#/$defs/pages"
        },
        "data": {
          "type": "object"
        }
      }
    },
    "registry": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "description"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "urn:drpg:schema:common#/$defs/identifier"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "params": {
            "description": "Parameter segments accepted after the id (e.g. 'ability' for ability_mod.<ability>).",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "type": {
            "enum": [
              "number",
              "boolean",
              "dice",
              "identifier",
              "event",
              "predicate"
            ]
          },
          "ref": {
            "$ref": "urn:drpg:schema:common#/$defs/ref"
          },
          "pages": {
            "$ref": "#/$defs/pages"
          },
          "lot": {
            "description": "Lot that declared the name.",
            "$ref": "urn:drpg:schema:common#/$defs/lot"
          },
          "formula": {
            "description": "How the engine computes this value or default (copied from the rule that states it).",
            "$ref": "urn:drpg:schema:expression"
          },
          "formula_source": {
            "description": "JSON pointer (in system.json) of the rule the formula comes from.",
            "type": "string",
            "pattern": "^#/"
          }
        }
      }
    }
  }
}
